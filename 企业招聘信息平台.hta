<script>
// ============================================================
// 核心应用逻辑：搜索、筛选、排序、渲染、收藏夹管理
// 采用 IIFE 模式隔离作用域，避免全局变量污染
// ============================================================
(function () {
  'use strict';

  // --- 应用状态：所有筛选条件的当前值 ---
  var state = {
    searchTerm: '',
    activeCategory: 'all',
    sortMethod: 'default',
    campusOnly: false,
    showFavoritesOnly: false
  };

  // --- DOM引用缓存：避免重复查询 ---
  var searchInput   = document.getElementById('searchInput');
  var searchClear   = document.getElementById('searchClear');
  var categoryFilters = document.getElementById('categoryFilters');
  var sortSelect    = document.getElementById('sortSelect');
  var campusCheckbox = document.getElementById('campusOnly');
  var favToggle     = document.getElementById('favToggle');
  var favCount      = document.getElementById('favCount');
  var cardGrid      = document.getElementById('cardGrid');
  var emptyState    = document.getElementById('emptyState');
  var resultsCount  = document.getElementById('resultsCount');
  var backToTop     = document.getElementById('backToTop');

  // ===================== 初始化入口 =====================

  function init() {
    renderCategoryPills();   // 渲染分类胶囊按钮
    filterAndRender();       // 首次渲染全部公司
    updateFavCount();        // 更新收藏夹徽章
    bindEvents();            // 绑定用户交互事件
  }

  // ===================== 分类胶囊按钮 =====================

  /** 根据 CATEGORIES 数组动态生成分类筛选按钮 */
  function renderCategoryPills() {
    var fragment = document.createDocumentFragment();
    CATEGORIES.forEach(function (cat) {
      var btn = document.createElement('button');
      btn.className = 'category-pill' + (cat.key === 'all' ? ' active' : '');
      btn.textContent = cat.label;
      btn.dataset.category = cat.key;
      fragment.appendChild(btn);
    });
    categoryFilters.appendChild(fragment);
  }

  // ===================== 筛选+排序+渲染 核心管线 =====================

  /**
   * 根据当前 state 对 COMPANIES 进行多轮过滤和排序，最终渲染
   * 这是一个纯数据管线：分类过滤 → 校招过滤 → 收藏过滤 → 搜索 → 排序 → 渲染
   */
  function filterAndRender() {
    var list = COMPANIES.slice(); // 浅拷贝，避免修改原数组

    // 1. 分类筛选
    if (state.activeCategory !== 'all') {
      list = list.filter(function (c) {
        return c.categories.indexOf(state.activeCategory) !== -1;
      });
    }

    // 2. 仅看校招
    if (state.campusOnly) {
      list = list.filter(function (c) { return c.hasCampusRecruit; });
    }

    // 3. 仅看收藏
    if (state.showFavoritesOnly) {
      var favIds = getFavorites();
      list = list.filter(function (c) { return favIds.indexOf(c.id) !== -1; });
    }

    // 4. 全文搜索：匹配公司名、职位、标签、城市、描述
    if (state.searchTerm.trim()) {
      var term = state.searchTerm.trim().toLowerCase();
      list = list.filter(function (c) {
        var haystack = [
          c.nameCN, c.nameEN.toLowerCase(),
          c.positions.join(' '), (c.tags || []).join(' '),
          (c.cities || []).join(' '), c.description || ''
        ].join(' ').toLowerCase();
        return haystack.indexOf(term) !== -1;
      });
    }

    // 5. 排序
    if (state.sortMethod === 'name') {
      list.sort(function (a, b) { return a.nameCN.localeCompare(b.nameCN, 'zh'); });
    } else if (state.sortMethod === 'rank') {
      list.sort(function (a, b) { return (a.fortuneRank || 999) - (b.fortuneRank || 999); });
    }

    renderCompanies(list);
  }

  // ===================== 渲染卡片网格 =====================

  /**
   * 将筛选后的公司列表渲染为卡片网格
   * 使用 DocumentFragment 批量插入，减少 DOM 回流次数
   */
  function renderCompanies(list) {
    cardGrid.innerHTML = '';

    if (list.length === 0) {
      cardGrid.style.display = 'none';
      emptyState.style.display = 'block';
      resultsCount.textContent = '找到 0 家公司';
      return;
    }

    cardGrid.style.display = '';
    emptyState.style.display = 'none';
    resultsCount.textContent = '找到 ' + list.length + ' 家公司';

    var fragment = document.createDocumentFragment();
    list.forEach(function (company) {
      fragment.appendChild(createCard(company));
    });
    cardGrid.appendChild(fragment);
  }

  // ===================== 单张卡片创建 =====================

  /**
   * 根据公司数据创建一张完整的卡片 DOM 元素
   * 包含：收藏星标、公司头像、名称、行业、城市、职位标签、操作按钮
   */
  function createCard(company) {
    var card = document.createElement('div');
    card.className = 'card';
    card.dataset.id = company.id;

    // ---- 收藏星标按钮 ----
    var starBtn = document.createElement('button');
    starBtn.className = 'card-star' + (isFavorite(company.id) ? ' favorited' : '');
    starBtn.title = isFavorite(company.id) ? '取消收藏' : '添加收藏';
    starBtn.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
    starBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      toggleFavorite(company.id);
      var nowFav = isFavorite(company.id);
      starBtn.classList.toggle('favorited', nowFav);
      starBtn.title = nowFav ? '取消收藏' : '添加收藏';
      updateFavCount();

      // 如果在收藏视图且取消了收藏，需要从视图中移除该卡片
      if (state.showFavoritesOnly && !nowFav) {
        filterAndRender();
      }
    });
    card.appendChild(starBtn);

    // ---- 卡片头部（头像 + 名称） ----
    var header = document.createElement('div');
    header.className = 'card-header';

    var avatar = document.createElement('div');
    avatar.className = 'card-avatar';
    avatar.textContent = company.nameCN.charAt(0);
    header.appendChild(avatar);

    var nameGroup = document.createElement('div');
    nameGroup.className = 'card-name-group';

    var nameCN = document.createElement('div');
    nameCN.className = 'card-name';
    nameCN.textContent = company.nameCN;

    var nameEN = document.createElement('div');
    nameEN.className = 'card-name-en';
    nameEN.textContent = company.nameEN;

    var industry = document.createElement('span');
    industry.className = 'card-industry';
    industry.textContent = company.industry + (company.hiring ? ' · 招聘中' : '');

    nameGroup.appendChild(nameCN);
    nameGroup.appendChild(nameEN);
    nameGroup.appendChild(industry);
    header.appendChild(nameGroup);
    card.appendChild(header);

    // ---- 城市信息 ----
    if (company.cities && company.cities.length > 0) {
      var cities = document.createElement('div');
      cities.className = 'card-cities';
      cities.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>';
      cities.appendChild(document.createTextNode(formatCities(company.cities)));
      card.appendChild(cities);
    }

    // ---- 招聘职位标签 ----
    var positionsDiv = document.createElement('div');
    positionsDiv.className = 'card-positions';
    (company.positions || []).forEach(function (pos) {
      var tag = document.createElement('span');
      tag.className = 'position-tag';
      tag.textContent = pos;
      positionsDiv.appendChild(tag);
    });
    card.appendChild(positionsDiv);

    // ---- 企业特色标签 ----
    if (company.tags && company.tags.length > 0) {
      var tagsDiv = document.createElement('div');
      tagsDiv.className = 'card-tags';
      company.tags.slice(0, 4).forEach(function (t) {
        var tag = document.createElement('span');
        tag.className = 'tag';
        tag.textContent = t;
        tagsDiv.appendChild(tag);
      });
      card.appendChild(tagsDiv);
    }

    // ---- 底部操作按钮（官网 + 投递简历） ----
    var actions = document.createElement('div');
    actions.className = 'card-actions';

    var websiteBtn = document.createElement('a');
    websiteBtn.className = 'btn btn-outline';
    websiteBtn.href = company.website;
    websiteBtn.target = '_blank';
    websiteBtn.rel = 'noopener';
    websiteBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>官网';

    var careerBtn = document.createElement('a');
    careerBtn.className = 'btn btn-primary';
    careerBtn.href = company.careerPage;
    careerBtn.target = '_blank';
    careerBtn.rel = 'noopener';
    careerBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>投递简历';

    actions.appendChild(websiteBtn);
    actions.appendChild(careerBtn);
    card.appendChild(actions);

    return card;
  }

  // ===================== 收藏夹计数更新 =====================

  function updateFavCount() {
    var count = getFavoritesCount();
    favCount.textContent = count;
    favToggle.classList.toggle('active', state.showFavoritesOnly);
  }

  // ===================== 事件绑定 =====================

  function bindEvents() {
    // 搜索输入（防抖300ms，减少高频过滤）
    searchInput.addEventListener('input', debounce(function () {
      state.searchTerm = this.value;
      searchClear.classList.toggle('visible', !!this.value.trim());
      filterAndRender();
    }, 300));

    // 清除搜索按钮
    searchClear.addEventListener('click', function () {
      searchInput.value = '';
      state.searchTerm = '';
      searchClear.classList.remove('visible');
      filterAndRender();
      searchInput.focus();
    });

    // 分类筛选（事件委托）
    categoryFilters.addEventListener('click', function (e) {
      var pill = e.target.closest('.category-pill');
      if (!pill) return;

      var pills = categoryFilters.querySelectorAll('.category-pill');
      for (var i = 0; i < pills.length; i++) pills[i].classList.remove('active');
      pill.classList.add('active');
      state.activeCategory = pill.dataset.category;
      filterAndRender();
    });

    // 排序切换
    sortSelect.addEventListener('change', function () {
      state.sortMethod = this.value;
      filterAndRender();
    });

    // 仅显示校招
    campusCheckbox.addEventListener('change', function () {
      state.campusOnly = this.checked;
      filterAndRender();
    });

    // 收藏夹切换按钮
    favToggle.addEventListener('click', function () {
      state.showFavoritesOnly = !state.showFavoritesOnly;
      updateFavCount();
      filterAndRender();
    });

    // 回到顶部按钮（滚动超过400px时显示）
    window.addEventListener('scroll', function () {
      backToTop.classList.toggle('visible', window.scrollY > 400);
    });

    backToTop.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // --- 启动 ---
  document.addEventListener('DOMContentLoaded', init);
})();
</script>
</body>
</html>
