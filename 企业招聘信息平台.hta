<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>中国企业招聘信息平台</title>
  <hta:application
    id="recruitApp"
    applicationname="中国企业招聘信息平台"
    border="thick"
    caption="yes"
    contextmenu="no"
    innerversion="1.0"
    maximizebutton="yes"
    minimizebutton="yes"
    navigable="no"
    scroll="no"
    selection="yes"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    version="1.0"
    windowstate="maximize"
  />
  <style>
/* ============================================================
   中国企业招聘信息平台 — 样式表
   配色：绿色(#2ecc71) + 白色(#ffffff) + 深海军蓝(#2c3e50)
   ============================================================ */

/* --- CSS 变量 --- */
:root {
  --green: #2ecc71;
  --green-dark: #27ae60;
  --green-light: #e8f8f0;
  --green-bg: #f4fdf8;
  --white: #ffffff;
  --navy: #2c3e50;
  --navy-light: #5a6d80;
  --navy-border: #dde4ea;
  --navy-bg: #f5f7fa;
  --shadow-sm: 0 1px 3px rgba(44, 62, 80, 0.06);
  --shadow-md: 0 4px 16px rgba(44, 62, 80, 0.08);
  --shadow-lg: 0 8px 30px rgba(44, 62, 80, 0.12);
  --radius: 12px;
  --radius-sm: 8px;
  --transition: 0.2s ease;
  --max-width: 1280px;
}

/* --- Reset & Base --- */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: system-ui, -apple-system, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  background-color: var(--navy-bg);
  color: var(--navy);
  line-height: 1.6;
  min-height: 100vh;
}
a { color: var(--green-dark); text-decoration: none; }
a:hover { color: var(--green); }

/* --- Header --- */
.header {
  background: var(--white);
  border-bottom: 1px solid var(--navy-border);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}
.header-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}
.logo { flex-shrink: 0; }
.title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--navy);
  white-space: nowrap;
}
.subtitle {
  font-size: 0.8rem;
  color: var(--navy-light);
  background: var(--green-light);
  padding: 2px 10px;
  border-radius: 20px;
  white-space: nowrap;
}

/* --- Favorites Button --- */
.fav-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border: 2px solid var(--green);
  border-radius: 24px;
  background: var(--white);
  color: var(--green-dark);
  cursor: pointer;
  font-size: 0.9rem;
  font-weight: 600;
  transition: all var(--transition);
}
.fav-btn:hover { background: var(--green-light); }
.fav-btn.active { background: var(--green); color: var(--white); }
.fav-badge {
  background: var(--green);
  color: var(--white);
  font-size: 0.75rem;
  min-width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  padding: 0 6px;
}

/* --- Main Content --- */
.main {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 20px 24px 40px;
}

/* --- Toolbar --- */
.toolbar {
  background: var(--white);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 20px;
}
.search-box { position: relative; margin-bottom: 16px; }
.search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--navy-light);
  pointer-events: none;
}
.search-input {
  width: 100%;
  padding: 12px 44px 12px 44px;
  border: 2px solid var(--navy-border);
  border-radius: 28px;
  font-size: 1rem;
  color: var(--navy);
  background: var(--white);
  transition: border-color var(--transition);
  outline: none;
}
.search-input:focus { border-color: var(--green); }
.search-input::placeholder { color: var(--navy-light); }
.search-clear {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  font-size: 1.4rem;
  color: var(--navy-light);
  cursor: pointer;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background var(--transition);
  visibility: hidden;
}
.search-clear.visible { visibility: visible; }
.search-clear:hover { background: var(--navy-bg); }

/* --- Category Filters --- */
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.category-filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.category-pill {
  padding: 6px 16px;
  border: 1.5px solid var(--navy-border);
  border-radius: 20px;
  background: var(--white);
  color: var(--navy);
  font-size: 0.85rem;
  cursor: pointer;
  transition: all var(--transition);
  white-space: nowrap;
  user-select: none;
}
.category-pill:hover { border-color: var(--green); color: var(--green-dark); }
.category-pill.active { background: var(--green); border-color: var(--green); color: var(--white); }

/* --- Sort Box --- */
.sort-box {
  display: flex;
  align-items: center;
  gap: 12px;
}
.campus-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  font-size: 0.85rem;
  color: var(--navy);
  user-select: none;
}
.campus-toggle input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: var(--green);
  cursor: pointer;
}
.sort-select {
  padding: 6px 12px;
  border: 1.5px solid var(--navy-border);
  border-radius: 20px;
  background: var(--white);
  color: var(--navy);
  font-size: 0.85rem;
  cursor: pointer;
  outline: none;
}
.sort-select:focus { border-color: var(--green); }

/* --- Results Info --- */
.results-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.results-count {
  font-size: 0.9rem;
  color: var(--navy-light);
}

/* --- Card Grid --- */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 18px;
}

/* --- Company Card --- */
.card {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--navy-border);
  padding: 20px;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition), box-shadow var(--transition);
  position: relative;
}
.card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}
.card-star {
  position: absolute;
  top: 12px;
  right: 14px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  color: var(--navy-border);
  transition: color var(--transition), transform var(--transition);
}
.card-star:hover { transform: scale(1.2); }
.card-star.favorited { color: var(--green); }
.card-header {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 10px;
  padding-right: 28px;
}
.card-avatar {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  background: var(--green-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--green-dark);
}
.card-name-group { min-width: 0; }
.card-name {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--navy);
  line-height: 1.3;
}
.card-name-en {
  font-size: 0.75rem;
  color: var(--navy-light);
  margin-top: 1px;
}
.card-industry {
  display: inline-block;
  font-size: 0.72rem;
  color: var(--green-dark);
  background: var(--green-light);
  padding: 2px 8px;
  border-radius: 10px;
  margin-top: 4px;
  font-weight: 600;
}
.card-cities {
  font-size: 0.78rem;
  color: var(--navy-light);
  margin-top: 8px;
  display: flex;
  align-items: center;
  gap: 4px;
}
.card-cities svg { flex-shrink: 0; }

/* --- Positions --- */
.card-positions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 12px 0;
}
.position-tag {
  font-size: 0.76rem;
  padding: 3px 10px;
  border-radius: 12px;
  background: var(--navy-bg);
  color: var(--navy);
  border: 1px solid var(--navy-border);
  white-space: nowrap;
}

/* --- Tags --- */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 14px;
}
.tag {
  font-size: 0.7rem;
  padding: 2px 8px;
  border-radius: 8px;
  background: var(--green-light);
  color: var(--green-dark);
  font-weight: 600;
}

/* --- Card Actions --- */
.card-actions {
  display: flex;
  gap: 8px;
  margin-top: auto;
}
.btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 8px 14px;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all var(--transition);
  border: none;
}
.btn-primary { background: var(--green); color: var(--white); }
.btn-primary:hover { background: var(--green-dark); color: var(--white); }
.btn-outline {
  background: var(--white);
  color: var(--green-dark);
  border: 1.5px solid var(--green);
}
.btn-outline:hover { background: var(--green-light); color: var(--green-dark); }

/* --- Empty State --- */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: var(--navy-light);
}
.empty-state svg {
  margin-bottom: 16px;
  stroke: var(--navy-border);
}
.empty-state h3 {
  font-size: 1.1rem;
  color: var(--navy);
  margin-bottom: 8px;
}
.empty-state p { font-size: 0.9rem; }

/* --- Footer --- */
.footer {
  text-align: center;
  padding: 20px;
  color: var(--navy-light);
  font-size: 0.78rem;
  border-top: 1px solid var(--navy-border);
  background: var(--white);
}
.footer p { line-height: 1.8; }

/* --- Back to Top --- */
.back-to-top {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--green);
  color: var(--white);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition);
  z-index: 50;
}
.back-to-top.visible { opacity: 1; visibility: visible; }
.back-to-top:hover { background: var(--green-dark); transform: translateY(-2px); }

/* --- Responsive --- */
@media (max-width: 900px) {
  .card-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .header-inner { padding: 10px 16px; }
  .title { font-size: 1.1rem; }
  .subtitle { display: none; }
  .main { padding: 16px 14px 32px; }
  .toolbar { padding: 14px; }
  .filter-row { flex-direction: column; align-items: stretch; }
  .sort-box { justify-content: flex-end; }
}
@media (max-width: 600px) {
  .card-grid { grid-template-columns: 1fr; gap: 12px; }
  .title { font-size: 1rem; }
  .search-input { font-size: 0.9rem; padding: 10px 40px 10px 40px; }
  .card { padding: 16px; }
  .back-to-top { bottom: 16px; right: 16px; width: 40px; height: 40px; }
}
  </style>
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="header-inner">
      <div class="header-left">
        <!-- 内联 SVG Logo -->
        <svg class="logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="36" height="36" fill="none">
          <rect width="64" height="64" rx="14" fill="#2ecc71"/>
          <path d="M20 22h24v4H20zM20 30h18v4H20zM20 38h14v4H20z" fill="#ffffff"/>
          <circle cx="46" cy="40" r="10" fill="#2c3e50"/>
          <path d="M43 40l2 2 4-4" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h1 class="title">中国企业招聘信息平台</h1>
        <span class="subtitle">Fortune China 500 · CS专场</span>
      </div>
      <div class="header-right">
        <button class="fav-btn" id="favToggle" title="查看收藏夹">
          <svg class="fav-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <span>收藏夹</span>
          <span class="fav-badge" id="favCount">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main">
    <section class="toolbar">
      <div class="search-box">
        <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="搜索公司、职位、城市…" autocomplete="off">
        <button class="search-clear" id="searchClear" title="清除搜索">&times;</button>
      </div>
      <div class="filter-row">
        <div class="category-filters" id="categoryFilters"></div>
        <div class="sort-box">
          <label class="campus-toggle">
            <input type="checkbox" id="campusOnly"><span class="toggle-label">仅校招</span>
          </label>
          <select id="sortSelect" class="sort-select">
            <option value="default">默认排序</option>
            <option value="name">按名称 A-Z</option>
            <option value="rank">按排名</option>
          </select>
        </div>
      </div>
    </section>

    <div class="results-info">
      <span class="results-count" id="resultsCount">找到 0 家公司</span>
    </div>

    <section class="card-grid" id="cardGrid"></section>

    <div class="empty-state" id="emptyState" style="display:none;">
      <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <h3>没有找到匹配的公司</h3>
      <p>试试调整搜索条件或筛选条件</p>
    </div>
  </main>

  <footer class="footer">
    <p>数据来源：各公司官网、校招页面 · Fortune China 500</p>
    <p>数据更新于 2026-05-27 · 仅供学习参考</p>
  </footer>

  <button class="back-to-top" id="backToTop" title="回到顶部">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

<script>
// ============================================================
// 工具函数：收藏夹管理、防抖、格式化
// ============================================================

const FAVORITES_KEY = 'job-favorites';

/** 从 localStorage 读取收藏夹ID列表 */
function getFavorites() {
  try { return JSON.parse(localStorage.getItem(FAVORITES_KEY)) || []; }
  catch { return []; }
}

/** 保存收藏夹ID列表到 localStorage */
function saveFavorites(list) {
  localStorage.setItem(FAVORITES_KEY, JSON.stringify(list));
}

/** 判断某公司是否已收藏 */
function isFavorite(id) {
  return getFavorites().includes(id);
}

/** 切换收藏状态，返回切换后是否为收藏 */
function toggleFavorite(id) {
  var list = getFavorites();
  var idx = list.indexOf(id);
  if (idx === -1) list.push(id);
  else list.splice(idx, 1);
  saveFavorites(list);
  return list.indexOf(id) !== -1;
}

/** 获取收藏夹数量 */
function getFavoritesCount() {
  return getFavorites().length;
}

/**
 * 防抖函数：延迟执行，避免高频触发
 * @param {Function} fn - 要执行的函数
 * @param {number} delay - 延迟毫秒数
 */
function debounce(fn, delay) {
  var timer;
  return function () {
    var ctx = this, args = arguments;
    clearTimeout(timer);
    timer = setTimeout(function () { fn.apply(ctx, args); }, delay);
  };
}

/** 格式化城市列表，最多显示3个 */
function formatCities(cities) {
  if (!cities || cities.length === 0) return '';
  return cities.slice(0, 3).join(' / ');
}
</script>
