// 分类标签列表（用于筛选按钮）
var CATEGORIES = [
  { key: "all", label: "全部" },
  { key: "互联网", label: "互联网" },
  { key: "电商", label: "电商" },
  { key: "电信", label: "电信" },
  { key: "硬件", label: "硬件" },
  { key: "AI/大数据", label: "AI/大数据" },
  { key: "游戏", label: "游戏" },
  { key: "金融科技", label: "金融科技" },
  { key: "银行/金融", label: "银行/金融" },
  { key: "车企/智能驾驶", label: "车企" },
  { key: "企业软件/云", label: "企业软件" },
  { key: "云计算", label: "云计算" },
  { key: "物联网", label: "物联网" },
